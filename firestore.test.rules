rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Bovix — TEST Firestore Security Rules
// Deploy to: bovix-test
// ─────────────────────────────────────────────────────────────
// Permissive rules for development and CI/CD testing.
// Any authenticated user can read/write all collections.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
