rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Bovix — PRODUCTION Firestore Security Rules
// Deploy to: bovix-prod
// ─────────────────────────────────────────────────────────────
// These rules enforce authenticated access for all collections.
// Future enhancement: add owner-based access control once user
// UID is stored in documents (ownerId field).
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cattle Records ────────────────────────────────────────
    match /cattle/{cattleId} {
      allow read, write: if request.auth != null;
    }

    // ── Milking Records ───────────────────────────────────────
    match /milking_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // ── Company Receipts ──────────────────────────────────────
    match /company_receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }

    // ── Farm Stock ────────────────────────────────────────────
    match /farm_stock/{stockId} {
      allow read, write: if request.auth != null;
    }

    // ── Stock Usage History ───────────────────────────────────
    match /stock_usage/{usageId} {
      allow read, write: if request.auth != null;
    }

    // ── Default: deny all other paths ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
