rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User must be authenticated to access cattle data
    match /cattle/{cattleId} {
      allow read, write: if request.auth != null;
    }

    // User must be authenticated to access milking records
    match /milking_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // User must be authenticated to access company receipts
    match /company_receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }
  }
}
