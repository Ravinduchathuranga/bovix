{
  "name": "bovix",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.9",
    "expo-auth-session": "^57.0.5",
    "expo-crypto": "^57.0.1",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "^57.0.11",
    "expo-web-browser": "^57.0.2",
    "firebase": "^12.17.0",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "db:backup": "cd scripts && npx ts-node backup-firestore.ts",
    "db:backup:json": "cd scripts && npx ts-node backup-to-json.ts",
    "db:restore": "cd scripts && npx ts-node restore-firestore.ts",
    "db:seed-test": "cd scripts && FIRESTORE_TARGET=test npx ts-node restore-firestore.ts",
    "db:deploy-rules:prod": "npx firebase deploy --only firestore:rules --config firebase.json --project bovix-prod",
    "db:deploy-rules:test": "npx firebase deploy --only firestore:rules --config firebase.test.json --project bovix-test",
    "db:deploy-rules:backup": "npx firebase deploy --only firestore:rules --config firebase.backup.json --project bovix-backup"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.18",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-web": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
